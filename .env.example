# =========================================================
# SetFit Gym Environment Configuration
# Copy this file to .env and fill in real values
# =========================================================

FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=replace-with-a-64-char-hex-string

# DATABASE_URL=sqlite:///gym.db
DATABASE_URL=sqlite:///gym.db

SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

LOG_LEVEL=INFO

RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_ENABLED=True

UPI_ID=gym@upi
UPI_PAYEE_NAME=Gym Management
MEMBERSHIP_REMINDER_DAYS=7

ADMIN_EMAIL=admin@gym.local
ADMIN_DEFAULT_PASSWORD=ChangeMe@123

SCHEDULER_ENABLED=True
SCHEDULER_HOUR=2